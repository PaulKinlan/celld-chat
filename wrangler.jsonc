{
  "name": "celld-chat",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  "assets": { "directory": "./target", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "ChatRoom" }] },
